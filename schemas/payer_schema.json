{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payer",
  "type": "object",
  "required": ["id", "name", "is_active", "created_at", "updated_at"],
  "properties": {
    "id":                  { "type": "string", "minLength": 1 },
    "name":                { "type": "string", "minLength": 1 },
    "electronic_payer_id": { "type": ["string", "null"] },
    "address_line1":       { "type": ["string", "null"] },
    "address_city":        { "type": ["string", "null"] },
    "address_state":       { "type": ["string", "null"], "maxLength": 2 },
    "address_zip":         { "type": ["string", "null"] },
    "phone":               { "type": ["string", "null"] },
    "timely_filing_days":  { "type": ["integer", "null"], "minimum": 1 },
    "is_active":           { "type": "boolean" },
    "created_at":          { "type": "string", "format": "date-time" },
    "updated_at":          { "type": "string", "format": "date-time" }
  }
}
