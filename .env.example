# Copy to .env and fill in real values. Never commit .env.
ENV=qa
LOG_LEVEL=INFO

# Auth — used by framework/auth.py
RCM_USERNAME=qa.automation@example.com
RCM_PASSWORD=change-me
RCM_CLIENT_ID=
RCM_CLIENT_SECRET=

# DB — used by framework/db.py when @pytest.mark.db is set
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rcm_qa
DB_USER=rcm_ro
DB_PASSWORD=change-me
DB_DIALECT=postgresql+psycopg2  # postgresql+psycopg2 | mysql+pymysql | mongodb

# Optional Allure metadata
ALLURE_PROJECT=RCM-API
